{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_APP_ENV"
      ]
    },
    "build:vinext": {
      "dependsOn": [
        "^build:vinext"
      ],
      "outputs": [
        ".cloudflare/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_APP_ENV",
        "DEPLOY_ENV",
        "STRIPE_MODE",
        "STRIPE_CHEKOUT_DISABLED",
        "EMAIL_CONFIGURED",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "APP_ORIGIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:vinext": {
      "dependsOn": [
        "build:vinext"
      ],
      "env": [
        "DEPLOY_ENV",
        "STRIPE_MODE",
        "STRIPE_CHEKOUT_DISABLED",
        "EMAIL_CONFIGURED",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "APP_ORIGIN"
      ],
      "cache": false,
      "persistent": true
    },
    "deploy:vinext": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_APP_ENV",
        "DEPLOY_ENV",
        "STRIPE_MODE",
        "STRIPE_CHEKOUT_DISABLED",
        "EMAIL_CONFIGURED",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "APP_ORIGIN"
      ],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    }
  }
}
