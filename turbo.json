{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_GA_MEASUREMENT_ID"]
    },
    "build:vinext": {
      "dependsOn": ["^build:vinext"],
      "outputs": [".cloudflare/**", "dist/**"],
      "env": ["NEXT_PUBLIC_GA_MEASUREMENT_ID"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:vinext": {
      "dependsOn": ["build:vinext"],
      "cache": false,
      "persistent": true
    },
    "deploy:vinext": {
      "cache": false,
      "env": ["NEXT_PUBLIC_GA_MEASUREMENT_ID"],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    }
  }
}
