{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:vinext": {
      "dependsOn": ["^build:vinext"],
      "outputs": [".cloudflare/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:vinext": {
      "dependsOn": ["build:vinext"],
      "cache": false,
      "persistent": true
    },
    "deploy:vinext": {
      "cache": false
    }
  }
}
