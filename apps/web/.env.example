# Server-only MongoDB settings. Use stage credentials for local development.
# Keep credentials separate: URI contains only the Atlas host and options,
# e.g. mongodb+srv://<cluster-host>/?retryWrites=true&w=majority
NEXT_MONGODB_USERNAME=
NEXT_MONGODB_PASSWORD=
NEXT_MONGODB_URI=
NEXT_MONGODB_DB_NAME=

# CLI-only operation guard: exact database name, supplied explicitly when running a command.
# DB_CONFIRM_NAME=
# CLI-only administrator creation/reset; never expose these as runtime/public bindings.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
