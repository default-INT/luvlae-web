# Server-only MongoDB settings. Use stage credentials for local development.
# Keep credentials separate: URI contains only the Atlas host and options,
# e.g. mongodb+srv://<cluster-host>/?retryWrites=true&w=majority
NEXT_MONGODB_USERNAME=
NEXT_MONGODB_PASSWORD=
NEXT_MONGODB_URI=
NEXT_MONGODB_DB_NAME=

# CLI-only operation guard: exact database name, supplied explicitly when running a command.
# DB_CONFIRM_NAME=
# CLI-only administrator creation/reset; never expose these as runtime/public bindings.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Temporary paid-order simulation. Enable explicitly for test environments only.
MOCK_CHECKOUT_ENABLED=false

# Stripe checkout is available by default with valid keys; true pauses new checkout.
# Local/stage always use test mode. The CHEKOUT spelling is the configuration contract.
# Live requires both the production build marker and APP_ENV=production runtime binding.
STRIPE_MODE=test
STRIPE_CHEKOUT_DISABLED=false
# Local runtime environment; Cloudflare sets its own matching binding.
APP_ENV=development
# Runtime Stripe configuration. The publishable key is public by design, but is
# supplied by the owned checkout view rather than a NEXT_PUBLIC build variable.
# Keep values in ignored .env.local / Cloudflare secrets, never NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Local: populated by pnpm --filter @luvlae/web stripe:listen (CLI secret).
# Stage: use the separately registered endpoint secret in Cloudflare.
STRIPE_WEBHOOK_SECRET=
