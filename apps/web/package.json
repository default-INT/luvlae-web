{
  "name": "@luvlae/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/generate-dictionaries.mjs && next dev",
    "build": "node scripts/generate-dictionaries.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && node scripts/generate-dictionaries.mjs && tsc --noEmit",
    "sync:dictionaries": "node scripts/generate-dictionaries.mjs",
    "dev:vinext": "node scripts/generate-dictionaries.mjs && vite dev --port 3001",
    "build:vinext": "node scripts/generate-dictionaries.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "vinext": "1.0.1",
    "react-server-dom-webpack": "19.2.8",
    "@vinext/cloudflare": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "sass": "^1.90.0",
    "typescript": "^5",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "cf": "1.0.0-beta.11",
    "vite-css-modules": "1.16.0",
    "postcss": "8.5.28"
  },
  "type": "module"
}
